# ==============================================================================
# Environment Variables for Vercel & Production Deployment
# ==============================================================================

# WooCommerce REST API
WOOCOMMERCE_STORE_URL="https://deencommerce.com"
WOOCOMMERCE_CONSUMER_KEY="ck_your_consumer_key"
WOOCOMMERCE_CONSUMER_SECRET="cs_your_consumer_secret"

# Pathao Hermes API
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID="your_pathao_client_id"
PATHAO_CLIENT_SECRET="your_pathao_client_secret"
PATHAO_USERNAME="your_email@domain.com"
PATHAO_PASSWORD="your_password"

# Optional: LLM Intelligence API Keys
OPENROUTER_KEY=""
GEMINI_KEY=""
GROQ_KEY=""
HUGGINGFACE_KEY=""

# ==============================================================================
# Google Analytics 4 (GA4) & Google Cloud Service Account
# ==============================================================================
GA4_PROPERTY_ID="your_ga4_property_id" # e.g. 314841375 or properties/314841375
GCP_PROJECT_ID="your_gcp_project_id"
GCP_CLIENT_EMAIL="your_service_account@project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY_ID="your_private_key_id"
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCP_CLIENT_ID="your_gcp_client_id"

# ==============================================================================
# Meta Ads & Pixel Marketing Integration
# ==============================================================================
META_PIXEL_ID="your_meta_pixel_id" # e.g. 2547021025592489
META_AD_ACCOUNT_ID="act_your_ad_account_id" # e.g. act_3397888253858911
META_ACCESS_TOKEN="your_meta_system_user_or_marketing_access_token"

# Persistent Cloud Storage & Cache
GCS_BUCKET_NAME="deen-bi-cache"
PERSISTENT_CACHE_NAMESPACE="shared"
